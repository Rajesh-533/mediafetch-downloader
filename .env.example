# MediaFetch Environment Configuration
PORT=3000
NODE_ENV=development

# Security & Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=25
MAX_DOWNLOAD_DURATION_SECONDS=7200
DOWNLOAD_TIMEOUT_MS=120000

# Optional custom binary paths (if not using auto-detected bin/yt-dlp or ffmpeg-static)
# YTDLP_PATH=
# FFMPEG_PATH=
